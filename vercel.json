{
    "version": 2,
    "framework": null,
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "regions": ["sin1"],
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.7.3"
        }
    },
    "routes": [
        {
            "src": "/build/(.*)",
            "dest": "/public/build/$1"
        },
        {
            "src": "/favicon.ico",
            "dest": "/public/favicon.ico"
        },
        {
            "src": "/robots.txt",
            "dest": "/public/robots.txt"
        },
        {
            "src": "/styles.css",
            "dest": "/public/styles.css"
        },
        {
            "src": "/script.js",
            "dest": "/public/script.js"
        },
        {
            "src": "/uploads/(.*)",
            "dest": "/public/uploads/$1"
        },
        {
            "src": "/(.*\\.(css|js|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot|pdf))",
            "dest": "/public/$1"
        },
        {
            "src": "/rich-editor/(.*)",
            "dest": "/api/index.php"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ],
    "env": {
        "DB_CONNECTION": "pgsql",
        "SESSION_DRIVER": "cookie",
        "PHP_VERSION": "8.3",
        "LOG_CHANNEL": "stderr",
        "APP_ENV": "production",
        "APP_DEBUG": "true",
        "APP_KEY": "base64:iLZV770wUkLwBVJQe7YcaZuzGVoU1NI/B611YUD8gp4=",
        "APP_CONFIG_CACHE": "/tmp/storage/framework/cache/config.php",
        "APP_EVENTS_CACHE": "/tmp/storage/framework/cache/events.php",
        "APP_PACKAGES_CACHE": "/tmp/storage/framework/cache/packages.php",
        "APP_ROUTES_CACHE": "/tmp/storage/framework/cache/routes.php",
        "APP_SERVICES_CACHE": "/tmp/storage/framework/cache/services.php",
        "VIEW_COMPILED_PATH": "/tmp/storage/framework/views"
    }
}
